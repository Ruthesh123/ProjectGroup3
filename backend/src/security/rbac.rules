rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStudent() {
      return hasRole('student');
    }

    function isEmployer() {
      return hasRole('employer');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isVerifiedEmployer() {
      return isEmployer() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }

    // Users collection rules
    match /users/{userId} {
      // Anyone can read their own profile
      allow read: if isOwner(userId);

      // Students can view employer profiles
      allow read: if isStudent() && resource.data.role == 'employer';

      // Employers can view student profiles (for applications)
      allow read: if isEmployer() && resource.data.role == 'student';

      // Admins can read all profiles
      allow read: if isAdmin();

      // Users can update their own profile
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role && // Can't change role
        request.resource.data.uid == resource.data.uid; // Can't change UID

      // Only admins can create new users (handled by Cloud Functions)
      allow create: if false;

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Jobs collection rules
    match /jobs/{jobId} {
      // Anyone authenticated can read active jobs
      allow read: if isAuthenticated() &&
        (resource.data.status == 'active' || isOwner(resource.data.employerId) || isAdmin());

      // Students can read active jobs
      allow read: if isStudent() && resource.data.status == 'active';

      // Verified employers can create jobs
      allow create: if isVerifiedEmployer() &&
        request.resource.data.employerId == request.auth.uid &&
        request.resource.data.status in ['draft', 'active'];

      // Employers can update their own jobs
      allow update: if isEmployer() &&
        resource.data.employerId == request.auth.uid;

      // Employers can delete their own jobs
      allow delete: if isEmployer() &&
        resource.data.employerId == request.auth.uid;

      // Admins have full access
      allow read, write: if isAdmin();
    }

    // Applications collection rules
    match /applications/{applicationId} {
      // Students can read their own applications
      allow read: if isStudent() &&
        resource.data.studentId == request.auth.uid;

      // Employers can read applications to their jobs
      allow read: if isEmployer() &&
        resource.data.employerId == request.auth.uid;

      // Students can create applications
      allow create: if isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Students can withdraw their applications
      allow update: if isStudent() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'withdrawn';

      // Employers can update application status
      allow update: if isEmployer() &&
        resource.data.employerId == request.auth.uid &&
        request.resource.data.status in ['reviewing', 'shortlisted', 'rejected', 'accepted'];

      // Admins have full access
      allow read, write: if isAdmin();
    }

    // Notifications collection rules
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.keys().hasAll(['read', 'readAt']);

      // Only system can create notifications (via Cloud Functions)
      allow create: if false;

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid;
    }

    // Audit logs collection rules
    match /audit_logs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();

      // Only system can write audit logs (via Cloud Functions)
      allow write: if false;
    }

    // Saved jobs collection rules
    match /saved_jobs/{savedJobId} {
      // Students can read their own saved jobs
      allow read: if isStudent() &&
        resource.data.studentId == request.auth.uid;

      // Students can save jobs
      allow create: if isStudent() &&
        request.resource.data.studentId == request.auth.uid;

      // Students can delete their saved jobs
      allow delete: if isStudent() &&
        resource.data.studentId == request.auth.uid;

      // Admins have full access
      allow read, write: if isAdmin();
    }

    // Messages collection rules
    match /messages/{messageId} {
      // Users can read messages they're part of
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);

      // Users can send messages
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid;

      // Messages cannot be updated or deleted (for audit trail)
      allow update, delete: if false;
    }

    // Conversations collection rules
    match /conversations/{conversationId} {
      // Users can read conversations they're part of
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants.map(p => p.id);

      // Users can create conversations
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants.map(p => p.id);

      // Users can update conversations they're part of (for unread counts)
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants.map(p => p.id);

      // Conversations cannot be deleted
      allow delete: if false;
    }
  }
}