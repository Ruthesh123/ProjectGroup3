# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Email Configuration (Gmail Example)
EMAIL_USER=noreply@yourcompany.com
EMAIL_PASS=your-app-specific-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM="InternLink <noreply@interlink.com>"

# SendGrid Configuration (Alternative to Gmail)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@interlink.com
# SENDGRID_FROM_NAME=InternLink

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://interlink.com

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits (in MB)
MAX_RESUME_SIZE_MB=5
MAX_IMAGE_SIZE_MB=2
MAX_FILE_UPLOADS_PER_DAY=10

# Database Configuration
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_EMULATOR_PORT=8080

# Authentication
AUTH_EMULATOR_HOST=localhost:9099
AUTH_EMULATOR_PORT=9099

# Storage
STORAGE_EMULATOR_HOST=localhost:9199
STORAGE_EMULATOR_PORT=9199

# Functions
FUNCTIONS_EMULATOR_HOST=localhost:5001
FUNCTIONS_EMULATOR_PORT=5001

# Environment
NODE_ENV=development
# Options: development, staging, production

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Admin Configuration
ADMIN_EMAIL=admin@interlink.com
INITIAL_ADMIN_PASSWORD=Admin123!@#

# Notification Settings
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_BATCH_SIZE=100

# Job Settings
JOB_EXPIRY_DAYS=60
JOB_FEATURED_LIMIT=10

# Application Settings
APPLICATION_LIMIT_PER_JOB=500
APPLICATION_DAILY_LIMIT_PER_STUDENT=10

# Session Configuration
SESSION_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# External APIs (Optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Monitoring (Optional)
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=your-ga-id

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_JOB_RECOMMENDATIONS=true
ENABLE_AI_MATCHING=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."